# Nuxfolio configuration.
#
# Copy to `.env.local` and edit. Every value below is optional: with an empty
# file Nuxfolio runs against public endpoints and shows real on-chain data.
# `.env.local` is git-ignored — never commit real keys.
#
# All variables are read server-side only. None is prefixed `NEXT_PUBLIC_`,
# so none can reach the browser.

# ---------------------------------------------------------------------------
# Balance discovery
# ---------------------------------------------------------------------------
# Optional. When set, Nuxfolio uses Alchemy's indexed token API and discovers
# every ERC-20 the wallet holds. When unset, it falls back to scanning a
# bundled token list over public RPC, which finds only listed tokens — the UI
# says so on every response.
# Get a key at https://dashboard.alchemy.com (free tier is sufficient).
ALCHEMY_API_KEY=

# Optional. Comma-separated JSON-RPC endpoints per network, tried in order.
# Each defaults to public endpoints that need no key. Use your own nodes or keyed
# provider URLs in production — public endpoints are rate limited.
#
# A keyed URL carries its credential in the path, so Nuxfolio never writes these
# URLs to a log: providers are identified as "endpoint 1", "endpoint 2" instead,
# and any value set here is additionally scrubbed from log output.
#
# ETHEREUM_RPC_URLS is also what resolves `.eth` names, whichever network's
# portfolio is being viewed — ENS lives on Ethereum mainnet.
ETHEREUM_RPC_URLS=
BASE_RPC_URLS=
ARBITRUM_RPC_URLS=
OPTIMISM_RPC_URLS=
BSC_RPC_URLS=

# Optional. Age in days at which a bundled token list is reported as possibly
# missing recently listed tokens. The lists ship with the deployment and are
# regenerated with `pnpm tokens:generate`, so without this a forgotten list would
# quietly understate portfolios. Only affects the keyless path — an indexer key
# makes the bundled lists irrelevant. Default: 60
TOKEN_LIST_MAX_AGE_DAYS=

# ---------------------------------------------------------------------------
# Prices
# ---------------------------------------------------------------------------
# Optional. Minimum price confidence (0-1) reported by the price provider before
# a quote is flagged as low confidence. Flagged quotes are still counted in the
# total — dropping them would understate the portfolio with nothing to explain
# the gap. Default: 0.7
PRICE_CONFIDENCE_MIN=

# Optional. Age in seconds after which a quote is labelled stale. A quote with no
# timestamp at all is labelled unknown-age rather than assumed fresh.
# Default: 3600
PRICE_MAX_AGE_SECONDS=

# Optional. A CoinGecko Demo key turns on the price cross-check: the prices that
# matter to the total are confirmed against a second source, and a disagreement is
# marked rather than resolved — neither source wins, and the primary price stays in
# the total. Without a key there is simply no cross-check and no warning: one
# source is the default state, not a fault. See docs/DECISIONS.md, ADR-019.
#
# Get a key at https://www.coingecko.com/en/api/pricing (Demo plan, free: 100
# calls/min, 10,000 calls/month). A key is effectively required for this to work
# at all — keylessly the endpoint accepts one contract address per request.
#
# The key travels as a header, never in a URL, and is scrubbed from log output.
#
# Using CoinGecko data obliges you to display their attribution. Nuxfolio renders
# "Powered by CoinGecko API" with a link whenever a cross-checked price is shown,
# derived from the response so it cannot be shown falsely or forgotten.
COINGECKO_API_KEY=

# Optional. Relative difference between the two sources before a price is marked
# as disputed. 0.02 is two percent. Default: 0.02
PRICE_DISPUTE_TOLERANCE=

# Optional. Share of each network's priced subtotal to cover when choosing which
# assets to cross-check, largest first. The monthly quota is finite, and a
# disagreement about a $3 dust holding changes no decision. Assets left unchecked
# are reported as unchecked, never as agreed. Default: 0.95
PRICE_CROSSCHECK_COVERAGE=

# Optional. Hard ceiling on assets cross-checked per network, whatever the
# coverage target implies. This is what bounds quota spend. Default: 25
PRICE_CROSSCHECK_MAX_ASSETS=

# Optional. Per-chain ceiling on assets given a 24h/7d price lookup, ordered by
# value. Each selected asset costs two batched requests' worth of refs; without a
# cap the 400-asset ceiling would allow 14 requests per chain. Set to 0 to turn the
# change column off entirely. Default: 50
PRICE_HISTORY_MAX_ASSETS=

# ---------------------------------------------------------------------------
# Caching, limits and abuse protection
# ---------------------------------------------------------------------------
# Optional. Portfolio cache lifetime in seconds. Default: 60
PORTFOLIO_CACHE_TTL_SECONDS=

# Optional. Maximum cached portfolios held in memory. The cache key is chosen by
# the caller (any address is a new key), so this bound is what stops it becoming
# a memory-exhaustion vector. Oldest entries are evicted first. Default: 500
PORTFOLIO_CACHE_MAX_ENTRIES=

# Optional. Requests allowed per client per window. Default: 30
# One all-networks page load spends one request per registered network (five
# today), because the browser assembles that view from per-chain responses as
# they arrive — see ADR-015. Keep the ceiling comfortably above that multiple.
RATE_LIMIT_MAX_REQUESTS=

# Optional. Rate-limit window in seconds. Default: 60
RATE_LIMIT_WINDOW_SECONDS=

# Optional. Set to `true` ONLY when Nuxfolio runs behind a proxy you control
# that overwrites the client-IP header. Leaving it false is the safe default:
# forwarded headers are caller-controlled and would make the rate limiter
# trivially bypassable. See docs/DECISIONS.md, ADR-008.
TRUST_PROXY_HEADERS=

# Optional. Header carrying the real client IP when TRUST_PROXY_HEADERS=true.
# Default: x-forwarded-for
CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------
# Work bounds
# ---------------------------------------------------------------------------
# Optional. Total wall-clock budget in milliseconds for ALL upstream work in one
# API request, shared across retries and both providers. Without one shared
# budget, per-request timeouts multiply. Default: 15000
REQUEST_DEADLINE_MS=

# Optional. Hard ceiling on assets returned per network. Token discovery is
# unbounded by nature — anyone can airdrop tokens into any wallet — so a wallet
# with thousands of spam tokens must not turn one page load into thousands of
# upstream calls. When the ceiling is hit the response says so. Default: 400
MAX_ASSETS_PER_PORTFOLIO=

# Optional. Networks scanned at the same time for an "all networks" request.
# Each network already runs its own bounded token sweep, so this multiplies the
# total in-flight upstream work. Default: 3
CHAIN_SCAN_CONCURRENCY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Optional. debug | info | warn | error. Default: info
LOG_LEVEL=

# ---------------------------------------------------------------------------
# History (M4) — all three optional; history is off until the first two are set
# ---------------------------------------------------------------------------
# Optional. Wallets the daily snapshot job records, comma separated. Kept in
# the environment rather than the repository, because the repository is public
# and this list says whose wallets they are. Empty means history is off.
NUXFOLIO_TRACKED_WALLETS=

# Optional. Shared secret for POST /api/snapshot. Without it the route answers
# 404 and no snapshot can be taken. Generate one: openssl rand -hex 32
NUXFOLIO_SNAPSHOT_KEY=

# Optional. Directory holding the snapshot database. Must live OUTSIDE the
# deployed app directory — the deploy rsyncs --delete into it. The deploy
# script sets this to ~/nuxfolio/data on the server. Default: .data
NUXFOLIO_DATA_DIR=
